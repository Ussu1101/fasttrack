# ===================================================================
# FastTrack Environment Configuration
# ===================================================================

# Canonical Public Site URL
# Used for SEO metadataBase, sitemaps, robots.txt, and canonical URLs.
# Defaults to https://www.fasttrackfastingcalculator.com if omitted.
NEXT_PUBLIC_SITE_URL=https://www.fasttrackfastingcalculator.com

# Site Owner & Contact Form Inquiries Recipient
# Submissions from /contact are routed to this destination email:
CONTACT_EMAIL_RECIPIENT=Usssamaa@gmail.com

# Email Delivery Provider API Key (e.g., Resend — https://resend.com)
# When this variable is omitted or empty, FastTrack operates in safe simulated mode,
# recording submissions to server logs without failing or requiring third-party credentials.
# To activate live inbox delivery to Usssamaa@gmail.com, set your API key here:
RESEND_API_KEY=

# Verified Custom Sender Address (Optional)
# If using a custom verified domain on Resend (e.g., contact@fasttrackfastingcalculator.com):
EMAIL_FROM=
